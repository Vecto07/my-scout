{
  "manifest_version": 2,
  "name": "My Scout",
  "version": "1.0.8",
  "description": "Save products to My Scout.",
  "browser_specific_settings": {
    "gecko": {
      "id": "my-scout@my-scout.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "contextMenus",
    "https://api.my-scout.app/*"
  ],
  "browser_action": {
    "default_title": "My Scout",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
