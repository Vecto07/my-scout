{
  "manifest_version": 2,
  "name": "Universal Cart",
  "version": "1.0.0",
  "description": "Save products to a future universal cart.",

  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "contextMenus",
    "http://localhost:8080/*"
  ],

  "browser_action": {
    "default_title": "Universal Cart",
    "default_popup": "popup.html"
  },

  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
