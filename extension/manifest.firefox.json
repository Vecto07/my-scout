{
  "manifest_version": 2,
  "name": "Scout",
  "version": "1.0.5",
  "description": "Save products to Scout.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "contextMenus",
    "https://api.my-scout.app/*"
  ],
  "browser_action": {
    "default_title": "Scout",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
