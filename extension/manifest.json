{
  "manifest_version": 3,
  "name": "Scout",
  "version": "1.0.5",
  "description": "Save products to Scout.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://api.my-scout.app/*"
  ],
  "action": {
    "default_title": "Scout",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
