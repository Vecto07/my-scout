{
  "manifest_version": 3,
  "name": "My Scout",
  "version": "1.0.9",
  "description": "Save products to My Scout.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://api.my-scout.app/*"
  ],
  "action": {
    "default_title": "My Scout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
