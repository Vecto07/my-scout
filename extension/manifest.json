{
  "manifest_version": 3,
  "name": "Universal Cart",
  "version": "1.0.0",
  "description": "Save products to a future universal cart.",

  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "contextMenus",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:8080/*"
  ],

  "action": {
    "default_title": "Universal Cart",
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  }
}
